{
  "format_version": "1.8.0",
  "animations": {
    "animation.civ_trial.swordsman.look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.civ_trial.swordsman.walk": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "left_leg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed * 80",
            0,
            0
          ]
        },
        "right_leg": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed * 80",
            0,
            0
          ]
        },
        "left_arm": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed * 40",
            0,
            0
          ]
        },
        "right_arm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed * 25",
            0,
            0
          ]
        }
      }
    },
    "animation.civ_trial.swordsman.attack": {
      "loop": true,
      "bones": {
        "right_arm": {
          "rotation": [
            "-math.sin(query.attack_time * 180) * 90",
            0,
            "-math.sin(query.attack_time * 180) * 10"
          ]
        }
      }
    }
  }
}
