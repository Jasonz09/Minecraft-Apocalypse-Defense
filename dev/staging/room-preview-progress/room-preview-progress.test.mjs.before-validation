import assert from 'node:assert/strict';
import test from 'node:test';
import {createRoomPreviewProgress,ROOM_PROGRESS_LIMITS} from '../../CivilizationApocalypse_BP/scripts/civ/roomPreviewProgress.js';
function setup(){const state={valid:true,tick:0,lines:[],hook:()=>{},checks:0};const p=createRoomPreviewProgress({current:()=>{state.checks++;return state.valid;},readTick:()=>state.tick,send:line=>{state.lines.push(line);state.hook();}});return{state,p};}
test('progress is bounded/rate limited by existing ticks, never percent source completion',()=>{const {state,p}=setup();for(let i=1;i<=100;i++){state.tick=i*200;p.report('source',i*512);}assert.equal(state.lines.length,8);p.report('planned',3200);state.tick+=200;p.report('planned',6400);for(let i=1;i<=8;i++){state.tick+=200;p.report('census',i*64,512);}assert.equal(state.lines.length,16);assert.equal(ROOM_PROGRESS_LIMITS.totalMessages,16);assert.ok(state.lines.every(s=>!s.includes('%')));});
test('unchanged tick suppresses repeats while phases may announce one transition',()=>{const {state,p}=setup();p.report('source',512);p.report('source',1024);assert.equal(state.lines.length,1);p.report('planned',3200);p.report('census',64,475);assert.equal(state.lines.length,3);});
test('cancel/source refusal brackets replies and no accepted progress after a reply mutation',()=>{const {state,p}=setup();state.valid=false;assert.throws(()=>p.report('source',512),/changed/);assert.equal(state.lines.length,0);state.valid=true;state.hook=()=>{state.valid=false;};assert.throws(()=>p.report('source',512),/changed/);assert.equal(state.lines.length,1);assert.throws(()=>p.report('source',1024),/changed/);assert.equal(state.lines.length,1);});
test('tick getter mutation is refused before send',()=>{let valid=true;const lines=[];const p=createRoomPreviewProgress({current:()=>valid,readTick:()=>{valid=false;return 1;},send:s=>lines.push(s)});assert.throws(()=>p.report('source',512));assert.equal(lines.length,0);});
test('synchronous send reentry invalidates outer progress and cannot publish subsequent callbacks',()=>{const {state,p}=setup();state.hook=()=>p.report('source',1024);assert.throws(()=>p.report('source',512),/reentered/);assert.equal(state.lines.length,1);state.hook=()=>{};state.tick=1000;assert.throws(()=>p.report('source',1536),/changed/);assert.equal(state.lines.length,1);});
test('invalid phase reversal/counters/total refuse; invalid clock never sends',()=>{const {state,p}=setup();p.report('census',64,475);assert.throws(()=>p.report('source',512));assert.throws(()=>p.report('census',63,475));assert.throws(()=>p.report('census',500,475));const a=setup();a.state.tick=NaN;a.p.report('source',512);assert.equal(a.state.lines.length,0);});

const {readFileSync}=await import('node:fs');
const actual=new URL('../../CivilizationApocalypse_BP/scripts/civ/roomVegetationPreview.js',import.meta.url);
const frozen=JSON.parse(readFileSync(new URL('../fixtures/room-preview-before-progress.json',import.meta.url),'utf8'));
let prior=frozen.module.replace(/from\s+(['"])([^'"]+)\1/g,(_,q,s)=>`from ${q}${(s.startsWith('.')?new URL(s,actual).href:s)}${q}`);
const baseline=await import('data:text/javascript;base64,'+Buffer.from(prior).toString('base64'));
const proposed=await import(actual.href);
const {SITE_STAGES}=await import('../../CivilizationApocalypse_BP/scripts/civ/districtplan.js');
function room(){const state={valid:true,reads:0,guards:0,reports:[],yields:0},element={id:'building-d5-chapel-1',kind:'building-chapel',stage:'lots',blueprint:'chapel_v2',rot:3,baseY:67,bbox:{x0:-220,x1:-206,z0:-540,z1:-532}},record={checksum:'23a6aeca',...Object.fromEntries(SITE_STAGES.map(s=>[s,[]])),lots:[element]};const ctx={current:()=>{state.guards++;return state.valid;},getBlock(){state.reads++;return{isValid:true,typeId:'minecraft:air',permutation:{getAllStates:()=>({})}};},opsFor:()=>[],progress:(...args)=>state.reports.push(args)};return{state,record,element,ctx};}
function finish(module,f){const g=module.roomVegetationPreviewSteps(f.record,f.element.id,f.ctx);for(;;){const n=g.next();if(n.done)return n.value;f.state.yields++;}}
test('progress callbacks preserve exact475read result/formatter and1cell yields; final report not source permission',()=>{const a=room(),b=room();const old=finish(baseline,a),fresh=finish(proposed,b);assert.deepEqual(fresh,old);assert.deepEqual(proposed.formatRoomVegetationPreview(fresh),baseline.formatRoomVegetationPreview(old));assert.equal(b.state.reads,475);assert.equal(b.state.yields,a.state.yields);assert.ok(b.state.guards>=a.state.guards);assert.equal(b.state.reports.at(-1)[1],475);assert.ok(b.state.reports.length<=8);});
for(const at of[64,475])test('source invalidated by progress callback atcell'+at+' refuses accepted result',()=>{const f=room();f.ctx.progress=(_phase,count)=>{if(count===at)f.state.valid=false;};assert.throws(()=>finish(proposed,f),/source\/player\/dimension changed/);assert.equal(f.state.reads,at);});
test('command source preserves exact job/rawguard/getter/final barriers and wraps only bounded optional progress',()=>{const source=readFileSync(new URL('../../CivilizationApocalypse_BP/scripts/commands/civ.js',import.meta.url),'utf8').replace(/\r\n/g,'\n'),a=source.indexOf('async function inspectSavedRoom('),b=source.indexOf('\n}\n',a),body=source.slice(a,b);for(const token of['guard.current()&&selectedCurrent()&&fastCurrent()&&guard.current()&&selectedCurrent()&&fastCurrent()','if(!current())throw Error("Room census source changed before reporting")','progress.report("source",slices)','progress:progress.report','finally{finishJob(token);}'])assert.ok(body.includes(token),token);for(const bad of['runInterval(','runTimeout(','setType(','setPermutation(','setDynamicProperty(','holdArea(','spawnEntity('])assert.equal(body.includes(bad),false,bad);});
